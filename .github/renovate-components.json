{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Self-hosted Renovate run (.github/workflows/components.yml). It follows the Components' release tags and opens one pull request per release that moves the submodule and refreshes both lock files. The hosted Renovate app reads renovate.json only, never this file.",
  "platform": "github",
  "repositories": [
    "JorisJonkers-dev/rauls-trusty-toolbox"
  ],
  "onboarding": false,
  "requireConfig": "ignored",
  "extends": [],
  "enabledManagers": [
    "custom.regex"
  ],
  "cloneSubmodules": true,
  "allowedCommands": [
    "^scripts/bump-component\\.sh [a-z-]+ v?[0-9.]+$",
    "^cargo update --workspace( --manifest-path crates/raul-gui/Cargo\\.toml)?$"
  ],
  "schedule": [
    "at any time"
  ],
  "timezone": "Etc/UTC",
  "minimumReleaseAge": null,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchPrefix": "renovate-components/",
  "rebaseWhen": "conflicted",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "commitMessageAction": "bump",
  "commitMessageTopic": "{{{depName}}}",
  "commitMessageExtra": "to {{{newValue}}}",
  "labels": [
    "dependencies",
    "component: dependencies"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The release of nv-rs the submodule is pinned at (its pin file under components/, which scripts/bump-component.sh keeps equal to the release-please manifest of the commit checked out in the submodule); each later release tag of its repository is an update.",
      "managerFilePatterns": [
        "/^components/nv-rs\\.version$/"
      ],
      "matchStrings": [
        "^(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*$"
      ],
      "depNameTemplate": "nv-rs",
      "packageNameTemplate": "JorisJonkers-dev/nv-rs",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver",
      "depTypeTemplate": "component"
    },
    {
      "customType": "regex",
      "description": "The release of nvmod-rs the submodule is pinned at (its pin file under components/, which scripts/bump-component.sh keeps equal to the release-please manifest of the commit checked out in the submodule); each later release tag of its repository is an update.",
      "managerFilePatterns": [
        "/^components/nvmod-rs\\.version$/"
      ],
      "matchStrings": [
        "^(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*$"
      ],
      "depNameTemplate": "nvmod",
      "packageNameTemplate": "JorisJonkers-dev/nvmod-rs",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver",
      "depTypeTemplate": "component"
    },
    {
      "customType": "regex",
      "description": "The release of lodwright-rs the submodule is pinned at (its pin file under components/, which scripts/bump-component.sh keeps equal to the release-please manifest of the commit checked out in the submodule); each later release tag of its repository is an update.",
      "managerFilePatterns": [
        "/^components/lodwright-rs\\.version$/"
      ],
      "matchStrings": [
        "^(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*$"
      ],
      "depNameTemplate": "lodwright-rs",
      "packageNameTemplate": "JorisJonkers-dev/lodwright-rs",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver",
      "depTypeTemplate": "component"
    },
    {
      "customType": "regex",
      "description": "The release of ttwright-rs the submodule is pinned at (its pin file under components/, which scripts/bump-component.sh keeps equal to the release-please manifest of the commit checked out in the submodule); each later release tag of its repository is an update.",
      "managerFilePatterns": [
        "/^components/ttwright-rs\\.version$/"
      ],
      "matchStrings": [
        "^(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*$"
      ],
      "depNameTemplate": "ttwright-rs",
      "packageNameTemplate": "JorisJonkers-dev/ttwright-rs",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver",
      "depTypeTemplate": "component"
    }
  ],
  "packageRules": [
    {
      "description": "loot-rs moves with nvmod (ADR-0015): the bump script takes the loot-rs tag nvmod links, so a loot-rs release alone is not an update here until nvmod links it.",
      "matchDepNames": [
        "loot-rs"
      ],
      "enabled": false
    },
    {
      "description": "Every Component bump is the same: move the submodule to the tag and refresh both lock files.",
      "matchManagers": [
        "custom.regex"
      ],
      "postUpgradeTasks": {
        "commands": [
          "scripts/bump-component.sh {{{depName}}} v{{{newVersion}}}",
          "cargo update --workspace",
          "cargo update --workspace --manifest-path crates/raul-gui/Cargo.toml"
        ],
        "fileFilters": [
          "Cargo.toml",
          "Cargo.lock",
          "crates/raul-gui/Cargo.lock",
          "components/**"
        ],
        "executionMode": "branch"
      }
    }
  ],
  "allowPostUpgradeCommandTemplating": true,
  "gitAuthor": "rauls-trusty-toolbox bump <noreply@github.com>"
}
