{
  "schema_version": 1,
  "contract": "lodwright-request",
  "data_folder": "<data>",
  "plugins": ["FalloutNV.esm"],
  "worlds": ["SyntheticWorld"],
  "output_dir": "<output>",
  "terrain": { "enabled": true, "levels": [], "land_textures": true, "water": true },
  "objects": { "enabled": true, "far_lights": true },
  "trees": { "enabled": false },
  "inclusion": {
    "exclude_plugins": ["Noisy.esp"],
    "only_plugins": [],
    "exclude_records": [],
    "exclude_models": ["clutter/*"],
    "include_rules": [
      { "models": "architecture/strip/nvstripstreetlamp*.nif", "record_type": "STAT", "generate": { "keep": 0.25, "max_error": 0.05 } },
      { "models": "architecture/urban/streetdressing/streetlight0*.nif", "record_type": "STAT", "generate": { "keep": 0.25, "max_error": 0.05 } },
      { "models": "architecture/urban/streetdressing/nvstreetlight0*.nif", "record_type": "STAT", "generate": { "keep": 0.25, "max_error": 0.05 } },
      { "models": "architecture/urban/streetdressing/lamppost0*.nif", "record_type": "STAT", "generate": { "keep": 0.25, "max_error": 0.05 } },
      { "models": "architecture/paradisefalls/parkinglot/parkinglotlight0*.nif", "record_type": "STAT", "generate": { "keep": 0.25, "max_error": 0.05 } },
      { "models": "architecture/paradisefalls/parkinglot/nv_parkinglotlight0*.nif", "record_type": "STAT", "generate": { "keep": 0.25, "max_error": 0.05 } },
      { "models": "dlc03/clutter/traffic lights/dlc03streetlight0*.nif", "record_type": "STAT", "generate": { "keep": 0.25, "max_error": 0.05 } },
      { "models": "clutter/tranquilitylane/tllamppost01.nif", "record_type": "STAT", "generate": { "keep": 0.25, "max_error": 0.05 } },
      { "models": "dungeons/caves/lamplight/lamplightlamp.nif", "record_type": "STAT", "generate": { "keep": 0.25, "max_error": 0.05 } }
    ]
  },
  "limits": { "threads": 2 },
  "output": { "pack": true }
}
